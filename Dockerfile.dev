# Multi-stage development Dockerfile optimized for hot-reload
# Stage 1: Base development environment
FROM eclipse-temurin:21-jdk AS development

WORKDIR /app

# Install required tools for development
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    wget \
    curl \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Copy gradle wrapper and properties first (changes least frequently)
COPY gradlew gradlew
COPY gradle.properties gradle.properties
COPY gradle/ gradle/

# Make gradlew executable
RUN chmod +x gradlew

# Copy build configuration files
COPY settings.gradle.kts settings.gradle.kts
COPY gradle/libs.versions.toml gradle/libs.versions.toml
COPY build.gradle.kts build.gradle.kts

# Download and cache dependencies (this layer will be cached unless dependencies change)
RUN ./gradlew dependencies --no-daemon --build-cache

# Copy configuration files
COPY config/ config/

# Create directory for H2 database with proper permissions
RUN mkdir -p /app/data && chmod 755 /app/data

# Environment variables for development
ENV KTOR_DEVELOPMENT=true
ENV KTOR_AUTORELOAD=true
ENV DATABASE_URL="jdbc:h2:file:/app/data/cycletime;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DB_CLOSE_DELAY=-1"
ENV DATABASE_LOGGING=true
ENV PORT=8080
ENV HOST=0.0.0.0

# JVM development optimizations
ENV JAVA_OPTS="-Xmx1024m -XX:+UseG1GC -XX:+UseStringDeduplication -Dfile.encoding=UTF-8"
ENV GRADLE_OPTS="-Dorg.gradle.daemon=false -Dorg.gradle.caching=true -Dorg.gradle.parallel=true"

# Expose MCP server port
EXPOSE 8080

# Development health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

# Default development command (can be overridden in docker-compose)
CMD ["./gradlew", "run", "-Pdevelopment=true", "--build-cache", "--continuous"]