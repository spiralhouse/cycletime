/**
 * Comprehensive failing tests for enhanced DI configuration system.
 * 
 * These tests will FAIL initially until the enhanced DI system is implemented.
 * They verify the requirements for SPI-442 including:
 * - Explicit scoping (singleton vs factory)
 * - Environment-specific configurations
 * - Profile-based configuration (dev/test/prod)
 * - Dependency validation
 * - Better error handling
 */
class DIConfigurationTest : StringSpec({

    "should provide singleton instance for singleton-scoped dependencies" {
        testApplication {
            application {
                // This will fail - enhanced configureDependencies doesn't exist yet
                configureEnhancedDependencies(ApplicationConfig.load("test"))
            }

            val container = application.diContainer
            val projectRepo1: ProjectRepository = container.resolve()
            val projectRepo2: ProjectRepository = container.resolve()

            // Should return same instance for singleton scope
            projectRepo1 shouldBeSameInstanceAs projectRepo2
        }
    }

    "should provide new instance for factory-scoped dependencies" {
        testApplication {
            application {
                // This will fail - factory scope not implemented yet
                configureEnhancedDependencies(ApplicationConfig.load("test"))
            }

            // Assuming we configure some service as factory-scoped
            val container = application.diContainer
            val service1: SomeFactoryService = container.resolve()
            val service2: SomeFactoryService = container.resolve()

            // Should return different instances for factory scope
            service1 shouldNotBeSameInstanceAs service2
            service1.javaClass shouldBe service2.javaClass
        }
    }

    "should respect explicit scope configuration from DIConfig" {
        testApplication {
            application {
                val diConfig = DIConfig.builder()
                    .singleton<ProjectRepository, ExposedProjectRepository>()
                    .factory<SomeFactoryService, SomeFactoryServiceImpl>()
                    .build()

                // This will fail - DIConfig doesn't exist yet
                configureEnhancedDependencies(ApplicationConfig.load("test"), diConfig)
            }

            val container = application.diContainer
            
            // Verify singleton behavior
            val repo1: ProjectRepository = container.resolve()
            val repo2: ProjectRepository = container.resolve()
            repo1 shouldBeSameInstanceAs repo2

            // Verify factory behavior
            val factory1: SomeFactoryService = container.resolve()
            val factory2: SomeFactoryService = container.resolve()
            factory1 shouldNotBeSameInstanceAs factory2
        }
    }

    "should detect circular dependencies on startup" {
        testApplication {
            application {
                val diConfig = DIConfig.builder()
                    .singleton<CircularServiceA, CircularServiceAImpl>()
                    .singleton<CircularServiceB, CircularServiceBImpl>()
                    .build()

                // This should fail with CircularDependencyException
                shouldThrow<CircularDependencyException> {
                    configureEnhancedDependencies(ApplicationConfig.load("test"), diConfig)
                }
            }
        }
    }

    "should validate all dependencies on startup" {
        testApplication {
            application {
                val testModule = object : io.spiralhouse.cycletime.infrastructure.di.core.DIModule {
                    override val name = "MissingDepsModule"
                    override fun configure(builder: DIContainer.Builder, profile: io.spiralhouse.cycletime.infrastructure.config.Profile) {
                        builder.singleton<ProjectRepository, ExposedProjectRepository>()
                        // Missing IssueRepository dependency for ProjectApplicationService
                        builder.singleton<ProjectApplicationService, ProjectApplicationService>()
                    }
                }
                
                // This should fail with MissingDependencyException
                shouldThrow<MissingDependencyException> {
                    configureEnhancedDependencies(ApplicationConfig.load("test"), listOf(testModule))
                    val container = application.diContainer
                    val service: ProjectApplicationService = container.resolve()
                }
            }
        }
    }

    "should provide helpful error messages for missing dependencies" {
        testApplication {
            application {
                val diConfig = DIConfig.builder()
                    .singleton<ProjectApplicationService, ProjectApplicationService>()
                    .build()

                configureEnhancedDependencies(ApplicationConfig.load("test"), diConfig)

                val exception = shouldThrow<MissingDependencyException> {
                    val service: ProjectApplicationService = application.diContainer.resolve()
                }

                exception.message shouldBe "Missing dependency: ProjectRepository required by ProjectApplicationService"
                exception.dependencyType shouldBe ProjectRepository::class
                exception.requestedBy shouldBe ProjectApplicationService::class
            }
        }
    }

    "should handle complex dependency chains correctly" {
        testApplication {
            application {
                val diConfig = DIConfig.builder()
                    .singleton<Database, Database>()
                    .singleton<UnitOfWork, ExposedUnitOfWork>()
                    .singleton<ProjectRepository, ExposedProjectRepository>()
                    .singleton<IssueRepository, ExposedIssueRepository>()
                    .singleton<SessionRepository, ExposedSessionRepository>()
                    .singleton<ProjectApplicationService, ProjectApplicationService>()
                    .singleton<IssueApplicationService, IssueApplicationService>()
                    .singleton<SessionApplicationService, SessionApplicationService>()
                    .build()

                // This will fail - enhanced DI doesn't exist yet
                configureEnhancedDependencies(ApplicationConfig.load("test"), diConfig)
            }

            // All services should be properly initialized with their dependencies
            val projectService: ProjectApplicationService = application.diContainer.resolve()
            val issueService: IssueApplicationService = application.diContainer.resolve()
            val sessionService: SessionApplicationService = application.diContainer.resolve()

            projectService shouldNotBe null
            issueService shouldNotBe null
            sessionService shouldNotBe null

            // Verify they have the correct implementations
            projectService.shouldBeInstanceOf<ProjectApplicationService>()
            issueService.shouldBeInstanceOf<IssueApplicationService>()
            sessionService.shouldBeInstanceOf<SessionApplicationService>()
        }
    }

    "should support conditional dependency registration" {
        testApplication {
            application {
                val diConfig = DIConfig.builder()
                    .conditionally("test") {
                        singleton<TimeProvider, MockTimeProvider>()
                    }
                    .conditionally("prod") {
                        singleton<TimeProvider, SystemTimeProvider>()
                    }
                    .build()

                // This will fail - conditional registration not implemented
                configureEnhancedDependencies(ApplicationConfig.load("test"), diConfig)
            }

            val timeProvider: TimeProvider = application.diContainer.resolve()
            timeProvider.shouldBeInstanceOf<MockTimeProvider>()
        }
    }

    "should override dependencies based on environment" {
        testApplication {
            application {
                val testConfig = ApplicationConfig.load("test")
                val diConfig = DIConfig.fromEnvironment(testConfig.profile)

                // This will fail - environment-based configuration not implemented
                configureEnhancedDependencies(testConfig, diConfig)
            }

            // In test environment, should use mock implementations
            val timeProvider: TimeProvider = application.diContainer.resolve()
            timeProvider.shouldBeInstanceOf<MockTimeProvider>()
        }
    }

    "should validate dependency compatibility on startup" {
        testApplication {
            application {
                val diConfig = DIConfig.builder()
                    .singleton<ProjectRepository, WrongRepositoryImplementation>()
                    .build()

                // This should fail with compatibility validation error
                shouldThrow<DependencyResolutionException> {
                    configureEnhancedDependencies(ApplicationConfig.load("test"), diConfig)
                }
            }
        }
    }

    "should support lazy dependency initialization" {
        testApplication {
            application {
                val diConfig = DIConfig.builder()
                    .lazy<ExpensiveService, ExpensiveServiceImpl>()
                    .build()

                // This will fail - lazy initialization not implemented
                configureEnhancedDependencies(ApplicationConfig.load("test"), diConfig)
            }

            // Service should not be initialized until first access
            // This verification will fail until lazy loading is implemented
            ExpensiveServiceImpl.initializationCount shouldBe 0

            val service: ExpensiveService = application.diContainer.resolve()
            ExpensiveServiceImpl.initializationCount shouldBe 1

            // Second access should not re-initialize
            val service2: ExpensiveService = application.diContainer.resolve()
            ExpensiveServiceImpl.initializationCount shouldBe 1
            service shouldBeSameInstanceAs service2
        }
    }

    "should provide dependency introspection capabilities" {
        testApplication {
            application {
                val diConfig = DIConfig.builder()
                    .singleton<ProjectRepository, ExposedProjectRepository>()
                    .factory<SomeFactoryService, SomeFactoryServiceImpl>()
                    .build()

                configureEnhancedDependencies(ApplicationConfig.load("test"), diConfig)
            }

            // This will fail - introspection API not implemented
            val registry: DependencyRegistry = application.diContainer.resolve()
            
            registry.getRegisteredTypes() shouldBe setOf(
                ProjectRepository::class,
                SomeFactoryService::class,
                Database::class,
                UnitOfWork::class
                // ... other registered types
            )

            registry.getScope(ProjectRepository::class) shouldBe Scope.SINGLETON
            registry.getScope(SomeFactoryService::class) shouldBe Scope.FACTORY
        }
    }

    "should support dependency decoration/proxying" {
        testApplication {
            application {
                val diConfig = DIConfig.builder()
                    .singleton<ProjectRepository, ExposedProjectRepository>()
                    .decorate<ProjectRepository> { original ->
                        LoggingProjectRepositoryDecorator(original)
                    }
                    .build()

                // This will fail - decoration not implemented
                configureEnhancedDependencies(ApplicationConfig.load("test"), diConfig)
            }

            val repository: ProjectRepository = application.diContainer.resolve()
            repository.shouldBeInstanceOf<LoggingProjectRepositoryDecorator>()
        }
    }

    "should handle dependency resolution performance efficiently" {
        testApplication {
            application {
                val diConfig = DIConfig.builder()
                    .singleton<ProjectRepository, ExposedProjectRepository>()
                    .singleton<IssueRepository, ExposedIssueRepository>()
                    .singleton<SessionRepository, ExposedSessionRepository>()
                    .build()

                configureEnhancedDependencies(ApplicationConfig.load("test"), diConfig)
            }

            // Measure resolution time - should be sub-millisecond for singletons
            val startTime = System.nanoTime()
            repeat(1000) {
                val repo: ProjectRepository = application.diContainer.resolve()
            }
            val endTime = System.nanoTime()
            val avgTimeNanos = (endTime - startTime) / 1000

            // This will fail until performance optimizations are implemented
            // avgTimeNanos shouldBe lessThan(100_000) // Less than 0.1ms average
            // Placeholder assertion that will fail
            avgTimeNanos shouldBe 0 // This will fail - we expect non-zero time
        }
    }
})

// Test classes that will need to be implemented for these tests to work

interface SomeFactoryService

class SomeFactoryServiceImpl : SomeFactoryService

interface CircularServiceA {
    val serviceB: CircularServiceB
}

interface CircularServiceB {
    val serviceA: CircularServiceA
}

class CircularServiceAImpl(override val serviceB: CircularServiceB) : CircularServiceA
class CircularServiceBImpl(override val serviceA: CircularServiceA) : CircularServiceB

class WrongRepositoryImplementation : ProjectRepository {
    // Intentionally wrong implementation for testing validation
    override suspend fun save(project: io.spiralhouse.cycletime.domain.entities.Project): io.spiralhouse.cycletime.domain.entities.Project {
        throw NotImplementedError("Wrong implementation")
    }

    override suspend fun findById(id: io.spiralhouse.cycletime.domain.valueobjects.ProjectId): io.spiralhouse.cycletime.domain.entities.Project? {
        throw NotImplementedError("Wrong implementation")
    }

    override suspend fun findAll(): List<io.spiralhouse.cycletime.domain.entities.Project> {
        throw NotImplementedError("Wrong implementation")
    }

    override suspend fun delete(id: io.spiralhouse.cycletime.domain.valueobjects.ProjectId) {
        throw NotImplementedError("Wrong implementation")
    }

    override suspend fun findByName(name: String): io.spiralhouse.cycletime.domain.entities.Project? {
        throw NotImplementedError("Wrong implementation")
    }
}

interface ExpensiveService

class ExpensiveServiceImpl : ExpensiveService {
    companion object {
        var initializationCount = 0
    }

    init {
        initializationCount++
        Thread.sleep(100) // Simulate expensive initialization
    }
}

interface DependencyRegistry {
    fun getRegisteredTypes(): Set<kotlin.reflect.KClass<*>>
    fun getScope(type: kotlin.reflect.KClass<*>): Scope
}

class LoggingProjectRepositoryDecorator(
    private val delegate: ProjectRepository
) : ProjectRepository by delegate {
    // Logging decorator implementation
}

class MockTimeProvider : TimeProvider {
    override fun now(): java.time.Instant = java.time.Instant.now()
}

class SystemTimeProvider : TimeProvider {
    override fun now(): java.time.Instant = java.time.Instant.now()
}

// Extension function is now implemented in the main code
// For tests that still use DIConfig, we'll need to convert them to use modules

fun Application.configureEnhancedDependencies(config: ApplicationConfig, diConfig: Any? = null) {
    // Use the real implementation with empty modules for now
    // Tests will be updated to use modules directly
    io.spiralhouse.cycletime.infrastructure.di.configureEnhancedDependencies(config)
}

// Custom matcher - using simple comparison for now
fun lessThan(value: Long) = object {
    fun matches(actual: Long) = actual < value
}