{
  "name": "jcvd",
  "version": "0.1.0",
  "description": "Simple context provider for Claude Code that enables cross-session continuity and project data management",
  "keywords": [
    "claude-code",
    "typescript",
    "sqlite",
    "mcp",
    "development",
    "context-provider"
  ],
  "homepage": "https://github.com/jburbridge/jcvd#readme",
  "bugs": {
    "url": "https://github.com/jburbridge/jcvd/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jburbridge/jcvd.git"
  },
  "license": "MIT",
  "author": {
    "name": "John Burbridge",
    "email": "john@example.com"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "jcvd": "./dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "dev": "tsx src/jcvd-simple.ts",
    "dev:watch": "tsx watch src/jcvd-simple.ts",
    "start": "node dist/jcvd-simple.js",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run test:run && npm run lint && npm run type-check",
    "validate": "npm run type-check && npm run lint && npm run test:run",
    "ci": "npm run validate && npm run build"
  },
  "engines": {
    "node": ">=22.17.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "better-sqlite3": "^11.8.0",
    "commander": "^12.1.0",
    "consola": "^3.2.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-unicorn": "^56.0.1",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": false
    }
  },
  "volta": {
    "node": "22.17.0",
    "npm": "10.9.0"
  },
  "packageManager": "npm@10.9.0"
}
